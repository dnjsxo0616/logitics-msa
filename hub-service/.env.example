# *****************************************
# Hub Service - Local Environment Variables
# *****************************************
# 이 파일은 허브 서비스의 로컬 개발 환경 구성을 위한 예시입니다
#
# 사용 방법:
#   1. 이 파일을 복사하여 .env 파일을 생성합니다
#   2. 각 값을 본인의 로컬 환경에 맞게 수정합니다
#
# 주의:
#   - 실제 비밀번호/서비스 키가 포함된 .env는 커밋하지 않습니다


# -- PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/logistics?currentSchema=hub_schema
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password


# -- Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password


# -- Hub Service
HUB_SERVICE_PORT=19007


# -- Eureka
# 로컬에서 실행 중인 Eureka Server 포트와 동일하게 설정합니다
EUREKA_PORT=19090


# -- Internal Service Communication
# Hub 내부 API 호출 시 사용하는 서비스 간 인증 키입니다
# Hub Service와 호출하는 서비스(Delivery 등)에 동일한 값을 설정해야 합니다
INTERNAL_SERVICE_KEY=your_internal_service_key